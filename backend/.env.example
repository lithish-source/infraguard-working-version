# Backend Environment Configuration
# Copy to .env and adjust as needed

# Application
APP_NAME=InfraGuard
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+psycopg2://infraguard:infraguard@localhost:5432/infraguard
POSTGRES_USER=infraguard
POSTGRES_PASSWORD=infraguard
POSTGRES_DB=infraguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT Auth
JWT_SECRET_KEY=change_this_to_a_long_random_string_in_production_5f8a2b9c1e7d
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# AI Module
AI_MODEL_PATH=./ai/models/severity_classifier.joblib
AI_CONFIDENCE_THRESHOLD=0.55
AI_USE_GPU=false

# LLM API (OPTIONAL — leave empty to use built-in scikit-learn classifier)
# Supports any OpenAI-compatible endpoint: Groq (Llama 3), Together AI, OpenAI, Ollama
# Get a free Groq API key at https://console.groq.com (recommended for Llama 3)
LLM_API_KEY=
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Alternative providers:
#   OpenAI:    LLM_API_BASE_URL=https://api.openai.com/v1
#              LLM_VISION_MODEL=gpt-4o-mini
#   Together:  LLM_API_BASE_URL=https://api.together.xyz/v1
#              LLM_VISION_MODEL=meta-vllama/Llama-3.2-90B-Vision-Instruct-Turbo
#   Ollama:    LLM_API_BASE_URL=http://localhost:11434/v1
#              LLM_VISION_MODEL=llama3.2-vision
#              LLM_API_KEY=ollama

# Default Admin (only used by seed script on first run)
DEFAULT_ADMIN_EMAIL=admin@infraguard.gov
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_NAME=System Administrator
