# Root-level environment configuration for InfraGuard
# Copy individual .env files into each service directory:
#   - backend/.env     (from backend/.env.example)
#   - docker/.env      (from docker/.env.example)
#
# Or use this file with docker compose by setting:
#   docker compose --env-file .env up

# === Required for production ===
# 32+ char random string for JWT signing — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please_change_me_to_a_long_random_secret_a1b2c3d4e5f6g7h8

# === Default admin (used by seed on first run) ===
DEFAULT_ADMIN_EMAIL=admin@infraguard.gov
DEFAULT_ADMIN_PASSWORD=Admin@12345

# === Database (defaults match docker-compose) ===
POSTGRES_USER=infraguard
POSTGRES_PASSWORD=infraguard
POSTGRES_DB=infraguard
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://infraguard:infraguard@db:5432/infraguard

# === Backend ===
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:5173","http://127.0.0.1"]
UPLOAD_DIR=/app/backend/uploads
MAX_UPLOAD_SIZE_MB=10

# === AI Module ===
AI_MODEL_PATH=/app/ai/models/severity_classifier.joblib
AI_CONFIDENCE_THRESHOLD=0.55
